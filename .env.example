# Placeholders only. Real values go in .env.local, which is gitignored.
# Never put a real key in this file, in argv, or in a log line.
#
# To fill a local copy:
#   cp .env.example .env.local

# ---------------------------------------------------------------- public
# Privy app ID. Safe to expose to the browser. Needed both by the Privy React
# provider and by the server route guards, which verify access tokens against
# this app ID's JWKS.
NEXT_PUBLIC_PRIVY_APP_ID=

# ---------------------------------------------------------------- server
# GOL test project and key from https://console.gol.network. A gol_test_ key is
# required for hosted gas; a live key gets capability_unavailable.
# Scopes: project:read, accounts:read, mandates:read, mandates:write, actions:submit
GOL_API_KEY=
GOL_PROJECT_ID=
# Optional. Defaults to https://api.gol.network
GOL_API_BASE_URL=

# Required. Read by lib/server/privy.ts to confirm that the account address in a
# request is a wallet linked to the logged-in user. Without it, any logged-in
# visitor could point the server at somebody else's account.
PRIVY_APP_SECRET=

# The agent's LLM. The model name is read from OPENAI_MODEL and never guessed.
OPENAI_API_KEY=
OPENAI_MODEL=

# The agent's signing key. Holds no funds, so it is safe to be disposable.
# Generate it without ever printing it:
#   node scripts/generate-agent-key.mjs
# That appends the key to .env.local and prints only the derived address.
AGENT_PRIVATE_KEY=

# Ceiling the agent may sign for a single transfer's network charge. GOL refuses
# a transfer above the owner's approved per-action cap, so keep this at or below
# the owner cap the demo uses (92000000000000 wei, which is 0.000092 ETH).
AGENT_MAX_CHARGE_WEI=92000000000000

# There is deliberately no recipients variable. Payees are not configuration: the
# owner fills a table of 1 to 16 name and address rows in the mandate form at
# approval time, and the agent resolves names against whatever that owner
# entered. A shared list in the environment would not be per-owner, and would
# make the demo's central claim, that the owner chooses the payees, untrue.

# Optional. Public Base Sepolia RPC used by the browser for read-only balance
# and receipt decoding. Defaults to https://sepolia.base.org when unset. This is
# public and keyless on purpose, so nothing secret belongs in it.
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=
