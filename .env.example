// Placeholders only. Real values go in .env.local, which is gitignored.
// Never put a real key in this file, in argv, or in a log line.

# ---------------------------------------------------------------- public
# Privy app ID. Safe to expose to the browser. Needed both by the Privy React
# provider and by the server route guards, which verify access tokens against
# this app ID's JWKS.
NEXT_PUBLIC_PRIVY_APP_ID=

# ---------------------------------------------------------------- server
# GOL test project and key from https://console.gol.network. A gol_test_ key is
# required for hosted gas; a live key gets capability_unavailable.
# Scopes: project:read, accounts:read, mandates:read, mandates:write, actions:submit
GOL_API_KEY=
GOL_PROJECT_ID=
# Optional. Defaults to https://api.gol.network
GOL_API_BASE_URL=

# Reserved. Server-side Privy access-token verification uses the public app ID
# and Privy's JWKS, so this is not currently read by any route. Set it anyway
# if the Privy app needs it for dashboard-level operations.
PRIVY_APP_SECRET=

# The agent's LLM. The model name is read from OPENAI_MODEL and never guessed.
OPENAI_API_KEY=
OPENAI_MODEL=

# The agent's signing key. Holds no funds. Replace the
# PrivyWalletProvider later without touching the GOL action provider.
AGENT_PRIVATE_KEY=

# Ceiling the agent may sign for a single transfer's network charge. GOL refuses
# a transfer above the owner's approved per-action cap, so keep this at or below
# the owner cap the demo uses (92000000000000 wei).
AGENT_MAX_CHARGE_WEI=92000000000000

# Demo recipients, addresses only, comma separated. Two are listed in the
# mandate; a third is deliberately unlisted to produce an on-chain refusal.
DEMO_RECIPIENTS=

# Optional. Public Base Sepolia RPC used by the browser for read-only receipt
# decoding. Defaults to https://sepolia.base.org when unset.
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=
